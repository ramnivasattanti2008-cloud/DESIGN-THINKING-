# Copy to .env (git-ignored). Never commit real keys.

# Model provider is undecided (see docs/DECISIONS.md D-002). The fake provider needs no key.
# fake (default, no key) | anthropic | gemini (free key from Google AI Studio)
MIRROR_MODEL_PROVIDER=fake
# MIRROR_MODEL_API_KEY=
# MIRROR_MODEL_NAME=

# Backend
MIRROR_HOST=127.0.0.1
MIRROR_PORT=8000

# Hardening (see docs/architecture/RUNNING.md)
# MIRROR_ENV=production
# MIRROR_API_KEY=
# MIRROR_ALLOWED_ORIGINS=
# MIRROR_RATE_LIMIT_PER_MINUTE=60
# MIRROR_SESSION_DB=
